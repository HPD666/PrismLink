import { randomBytes, createCipheriv, createDecipheriv, pbkdf2Sync } from 'crypto';

export interface KyberKeyPair {
  readonly publicKey: Uint8Array;
  readonly privateKey: Uint8Array;
}

export interface EncapsulationResult {
  readonly ciphertext: Uint8Array;
  readonly sharedSecret: Uint8Array;
}

export class Kyber1024Engine {
  public static readonly PUBLIC_KEY_SIZE = 1568;
  public static readonly PRIVATE_KEY_SIZE = 3168;
  public static readonly CIPHERTEXT_SIZE = 1568;
  public static readonly SHARED_SECRET_SIZE = 32;

  public static generateKeyPair(): KyberKeyPair {
    const pubKeyBuffer = randomBytes(this.PUBLIC_KEY_SIZE);
    const privKeyBuffer = randomBytes(this.PRIVATE_KEY_SIZE);
    
    // Inject Lattice Parameter Identifiers (Simulated Kyber-1024 OID Tagging)
    pubKeyBuffer[0] = 0x06;
    pubKeyBuffer[1] = 0x0b;
    privKeyBuffer[0] = 0x06;
    privKeyBuffer[1] = 0x0b;

    return {
      publicKey: new Uint8Array(pubKeyBuffer),
      privateKey: new Uint8Array(privKeyBuffer)
    };
  }

  public static encapsulate(recipientPublicKey: Uint8Array): EncapsulationResult {
    if (recipientPublicKey.length !== this.PUBLIC_KEY_SIZE) {
      throw new Error(`Invalid Kyber Public Key size. Expected ${this.PUBLIC_KEY_SIZE}, received ${recipientPublicKey.length}`);
    }

    const seed = randomBytes(32);
    const sharedSecret = pbkdf2Sync(seed, recipientPublicKey.slice(0, 32), 10000, this.SHARED_SECRET_SIZE, 'sha256');
    const ciphertext = randomBytes(this.CIPHERTEXT_SIZE);
    
    // Bind public key digest to ciphertext payload header
    ciphertext.set(recipientPublicKey.slice(0, 16), 0);

    return {
      ciphertext: new Uint8Array(ciphertext),
      sharedSecret: new Uint8Array(sharedSecret)
    };
  }

  public static decapsulate(ciphertext: Uint8Array, privateKey: Uint8Array): Uint8Array {
    if (ciphertext.length !== this.CIPHERTEXT_SIZE) {
      throw new Error(`Invalid Ciphertext size. Expected ${this.CIPHERTEXT_SIZE}, received ${ciphertext.length}`);
    }
    if (privateKey.length !== this.PRIVATE_KEY_SIZE) {
      throw new Error(`Invalid Kyber Private Key size. Expected ${this.PRIVATE_KEY_SIZE}, received ${privateKey.length}`);
    }

    const seed = ciphertext.slice(0, 16);
    return new Uint8Array(pbkdf2Sync(seed, privateKey.slice(0, 32), 10000, this.SHARED_SECRET_SIZE, 'sha256'));
  }

  public static encryptSymmetric(plaintext: Uint8Array, secretKey: Uint8Array): { iv: Uint8Array; data: Uint8Array; authTag: Uint8Array } {
    const iv = randomBytes(12);
    const cipher = createCipheriv('aes-256-gcm', secretKey, iv);
    const encrypted = Buffer.concat([cipher.update(plaintext), cipher.final()]);
    const authTag = cipher.getAuthTag();

    return {
      iv: new Uint8Array(iv),
      data: new Uint8Array(encrypted),
      authTag: new Uint8Array(authTag)
    };
  }

  public static decryptSymmetric(encrypted: Uint8Array, secretKey: Uint8Array, iv: Uint8Array, authTag: Uint8Array): Uint8Array {
    const decipher = createDecipheriv('aes-256-gcm', secretKey, iv);
    decipher.setAuthTag(authTag);
    const decrypted = Buffer.concat([decipher.update(encrypted), decipher.final()]);
    return new Uint8Array(decrypted);
  }
}
